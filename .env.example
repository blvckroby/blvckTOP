PORT=3000
# Manifest sorgente originale. Tienilo come variabile privata sul servizio di deploy.
SOURCE_MANIFEST_URL=https://example.com/manifest.json

# Segreto lungo e casuale. NON cambiarlo dopo aver generato manifest agli utenti:
# i token già generati smetterebbero di funzionare.
APP_SECRET=change-me-with-a-long-random-secret-at-least-32-characters
